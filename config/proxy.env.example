# Copy to /etc/cridervpn/proxy.env and edit as root.
# Forward proxies are restricted to LAN and Tailscale source ranges.
LAN_SOURCE_CIDR="10.42.0.0/24"
TAILSCALE_SOURCE_CIDR="100.64.0.0/10"
SOCKS5_PORT="1080"
HTTP_PROXY_PORT="3128"

# Reverse proxy is intentionally disabled until a backend and access method are chosen.
REVERSE_PROXY_ENABLED="false"
REVERSE_PROXY_LISTEN_PORT="8080"
REVERSE_PROXY_SERVER_NAME="_"
REVERSE_PROXY_BACKEND="http://127.0.0.1:3000"
