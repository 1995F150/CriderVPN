# Copy to /etc/cridervpn/cridervpn.env and edit as root.
# Do not commit the real file.

# Wi-Fi interface that receives internet, for example wlp2s0.
UPLINK_INTERFACE=""

# Ethernet interface that supplies the downstream network.
DOWNLINK_INTERFACE="enp3s0"

# Private IPv4 network served from the Ethernet port.
LAN_IPV4_CIDR="10.42.0.1/24"
LAN_IPV4_GATEWAY="10.42.0.1"
DHCP_RANGE_START="10.42.0.50"
DHCP_RANGE_END="10.42.0.200"

# DNS server advertised to clients. Use the gateway for local Pi-hole/CriderShield.
LAN_DNS_IPV4="10.42.0.1"

# IPv6 starts disabled for downstream clients until an explicit routed or VPN policy exists.
# Tailscale may still require kernel IPv6 forwarding internally.
IPV6_MODE="disabled"

# VPN modes: off, optional, required.
VPN_MODE="off"
WIREGUARD_INTERFACE="wg0"

# Tailscale exit-node and subnet-router settings.
TAILSCALE_ADVERTISE_ROUTES="10.42.0.0/24"

# Safety switches.
ENABLE_KILL_SWITCH="false"
ALLOW_SSH_FROM_LAN="true"
