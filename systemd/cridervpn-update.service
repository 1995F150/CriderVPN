[Unit]
Description=Check GitHub for CriderVPN updates
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cridervpn/update.env

[Service]
Type=oneshot
ExecStart=/opt/cridervpn/scripts/check-for-updates.sh
User=root
Group=root
Environment=HOME=/var/lib/cridervpn/update/home
Environment=XDG_CACHE_HOME=/var/lib/cridervpn/update/cache
Environment=NPM_CONFIG_CACHE=/var/lib/cridervpn/update/npm-cache
Environment=NPM_CONFIG_UPDATE_NOTIFIER=false
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/cridervpn /var/lib/cridervpn /run/lock /etc/systemd/system
