[Unit]
Description=Check GitHub for CriderVPN updates
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cridervpn/update.env

[Service]
Type=oneshot
ExecStart=/opt/cridervpn/scripts/check-for-updates.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/cridervpn /var/lib/cridervpn /run/lock /etc/systemd/system
