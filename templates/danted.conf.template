logoutput: syslog
user.privileged: root
user.unprivileged: nobody

internal: __LAN_IP__ port = __SOCKS5_PORT__
internal: __TAILSCALE_IP__ port = __SOCKS5_PORT__
external: __UPLINK_INTERFACE__

clientmethod: none
socksmethod: none

client pass {
  from: __LAN_SOURCE_CIDR__ to: 0.0.0.0/0
  log: connect disconnect error
}
client pass {
  from: __TAILSCALE_SOURCE_CIDR__ to: 0.0.0.0/0
  log: connect disconnect error
}
client block {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  log: connect error
}

socks pass {
  from: __LAN_SOURCE_CIDR__ to: 0.0.0.0/0
  command: connect bind udpassociate
  log: connect disconnect error
}
socks pass {
  from: __TAILSCALE_SOURCE_CIDR__ to: 0.0.0.0/0
  command: connect bind udpassociate
  log: connect disconnect error
}
socks block {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  log: connect error
}
