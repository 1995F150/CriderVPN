[Unit]
Description=CriderVPN CriderShield Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cridervpn
Group=cridervpn
WorkingDirectory=/opt/cridervpn/apps/cridershield
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SCANNER_ENABLED=true
Environment=PIHOLE_URL=http://127.0.0.1
Environment=CRIDER_DATA_DIR=/var/lib/cridervpn/cridershield
EnvironmentFile=-/etc/cridervpn/cridershield.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cridervpn/cridershield

[Install]
WantedBy=multi-user.target
