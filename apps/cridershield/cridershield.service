[Unit]
Description=CriderVPN CriderShield Dashboard and Engine Reverse Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cridervpn
Group=cridervpn
WorkingDirectory=/opt/cridervpn/apps/cridershield
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SCANNER_ENABLED=true
Environment=SCANNER_INTERVAL_MS=30000
Environment=ACTIVE_DISCOVERY=true
Environment=PIHOLE_URL=http://127.0.0.1
Environment=CRIDER_DATA_DIR=/var/lib/cridervpn/cridershield
Environment=CRIDERGPT_ENGINE_UPSTREAM=http://127.0.0.1:8000
Environment=PROXY_REQUEST_TIMEOUT_MS=120000
Environment=PROXY_HEALTH_INTERVAL_MS=15000
Environment=PROXY_HEALTH_TIMEOUT_MS=5000
EnvironmentFile=-/etc/cridervpn/cridershield.env
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cridervpn/cridershield

[Install]
WantedBy=multi-user.target
